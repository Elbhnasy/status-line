+        text = self._text(self._fixture(monkeypatch, tmp_path), 120, style="default")
+        assert "16K/200K" in text            # legacy context_detail segment
+        assert "context:" not in text
+        assert "example-workspace" not in text
+
+    def test_long_line_is_trimmed_not_wrapped(self, monkeypatch, tmp_path):
+        text = self._text(self._fixture(monkeypatch, tmp_path), 40)
+        assert cli_obj_width(cli_mod, text) <= 40
+
+
+class TestAccountUsageWindows:
+    """``_account_usage_windows``: provider lookup, cache read, staleness and the refresh call."""
+
+    @staticmethod
+    def _windows():
+        from datetime import datetime, timedelta, timezone
+
+        from agent.account_usage import AccountUsageSnapshot, AccountUsageWindow
+
+        now = datetime.now(timezone.utc)
+        return AccountUsageSnapshot(
+            provider="anthropic", source="oauth_usage_api", fetched_at=now,
+            windows=(AccountUsageWindow("Current session", 4.0, now + timedelta(hours=3)),
+                     AccountUsageWindow("Current week", 9.0, now + timedelta(days=3))))
+
+    @staticmethod
+    def _patch_cache(monkeypatch, *, supported, cached):
+        from agent import account_usage_cache as cache
+
+        refreshes = []
+        monkeypatch.setattr(cache, "has_account_usage", lambda slug: supported)
+        monkeypatch.setattr(cache, "cached_account_usage", lambda *a, **k: cached)
+        monkeypatch.setattr(cache, "refresh_account_usage_async",
+                            lambda providers: refreshes.append(tuple(providers)))
+        return refreshes
+
+    def test_the_provider_is_re_read_on_every_call(self, monkeypatch):
+        """The first status bar is drawn before ``self.agent`` exists (created on the first turn),
+        so an empty provider must not be remembered for the session; ``/model`` may switch later."""
+        refreshes = self._patch_cache(monkeypatch, supported=True, cached=self._windows())
+        cli_obj = _make_cli()
+        cli_obj.agent = None
+        cli_obj.provider = "auto"
+        assert cli_obj._account_usage_windows() == []
+
+        cli_obj.agent = SimpleNamespace(provider="anthropic", base_url="")
+        windows = cli_obj._account_usage_windows()
+        assert [w.label for w in windows] == ["Current session", "Current week"]
+        assert refreshes == [], "a fresh snapshot is rendered as-is"
+
+    def test_a_provider_without_usage_support_shows_nothing(self, monkeypatch):
+        refreshes = self._patch_cache(monkeypatch, supported=False, cached=self._windows())
+        cli_obj = _make_cli()
+        cli_obj.agent = SimpleNamespace(provider="openrouter", base_url="")
+        assert cli_obj._account_usage_windows() == []
+        assert refreshes == [], "an unsupported provider must not be refreshed in a loop"
+
+    def test_a_stale_snapshot_is_ignored_and_a_refresh_requested(self, monkeypatch):
+        from datetime import datetime, timedelta, timezone
+
+        from agent.account_usage import AccountUsageSnapshot, AccountUsageWindow
+
+        now = datetime.now(timezone.utc)
+        stale = AccountUsageSnapshot(
+            provider="anthropic", source="oauth_usage_api", fetched_at=now - timedelta(minutes=30),
+            windows=(AccountUsageWindow("Current session", 4.0, now + timedelta(hours=3)),))
+        refreshes = self._patch_cache(monkeypatch, supported=True, cached=stale)
+        cli_obj = _make_cli()
+        cli_obj.agent = SimpleNamespace(provider="anthropic", base_url="")
+        assert cli_obj._account_usage_windows() == []
+        assert refreshes == [("anthropic",)]
+
+
+def cli_obj_width(_mod, text):
+    from prompt_toolkit.utils import get_cwidth
+    return get_cwidth(text)
+
+
+class TestClaudeStyleFragments:
