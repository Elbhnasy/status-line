+"""Unit tests for the pure Claude-style status-bar helpers (no live HermesCLI)."""
+
+import pytest
+
+from hermes_cli import status_bar_claude as sb
+
+
+@pytest.mark.parametrize("pct,expected", [
+    (None, "\u2591" * 10),          # no data yet -> all empty, never a fake full/zero bar
+    (0, "\u2591" * 10),
+    (5, "\u2588" + "\u2591" * 9),   # 0.5 rounds half-up -> 1 cell
+    (8, "\u2588" + "\u2591" * 9),   # round(0.8) = 1
+    (50, "\u2588" * 5 + "\u2591" * 5),
+    (79, "\u2588" * 8 + "\u2591" * 2),
+    (100, "\u2588" * 10),
+    (-5, "\u2591" * 10),
+    (150, "\u2588" * 10),
+])
+def test_render_bar(pct, expected):
+    assert sb.render_bar(pct) == expected
+
+
+def test_render_bar_width_override():
+    assert sb.render_bar(50, width=4) == "\u2588\u2588\u2591\u2591"
+
+
+def test_usage_percent_disables_and_clamps():
+    assert sb.usage_percent(10, 0) is None       # budget 0 hides the segment
+    assert sb.usage_percent(10, -1) is None
+    assert sb.usage_percent(0, 1_000_000) == 0.0
+    assert sb.usage_percent(790_000, 1_000_000) == 79.0
+    assert sb.usage_percent(2_000_000, 1_000_000) == 100.0
+    assert sb.usage_percent(None, 1_000_000) == 0.0
+
