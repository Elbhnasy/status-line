@@ -0,0 +1,210 @@
+"""Pure helpers for the Claude-Code-style status bar (``display.status_bar.style: claude``).
+
+The layout implemented by ``cli_status_bar_mixin._claude_status_bar_segments`` is::
+
+    <dir> │ <model> │ <effort> │ context: <bar> <pct>% │ usage: <bar> <windows>
+
+``context`` is a fraction of the model's context window; ``usage`` reports the provider's own
+account-usage windows (``usage_windows_label``), never a percentage of an invented budget.
+
+Only pure functions and constants live here (no ``self``, no prompt_toolkit) so the layout math
+is unit testable without a live ``HermesCLI`` — same split as ``hermes_cli/status_bar_git.py``.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+from typing import Optional
+
+#: Cell count of both Claude-Code bars (context and usage).
+BAR_WIDTH = 10
+FILLED = "\u2588"   # █
+EMPTY = "\u2591"    # ░
+ELLIPSIS = "\u2026"  # …
+
+#: Documented default when ``agent.reasoning_effort`` is unset — "medium", see
+#: ``batch_runner.py`` help text and ``hermes_constants.parse_reasoning_effort``.
+DEFAULT_EFFORT = "medium"
+
+#: Longest directory label before middle-truncation kicks in.
+MAX_DIR_CHARS = 24
+
+#: Render order of the five fragments (Claude Code's order).
+SEGMENT_ORDER = ("dir", "model", "effort", "context", "usage")
+
+#: Segments given up, least important first, when the line is wider than the terminal.
+#: ``model`` and ``context`` are never dropped.
+DROP_ORDER = ("dir", "effort", "usage")
+
+#: Short bar labels for the windows Hermes' account-usage fetchers publish. An unknown label falls
+#: back to its first word, lowercased ("Session" -> "session"), so a new provider needs no edit.
+WINDOW_LABELS = {"Current session": "5h", "Current week": "wk",
+                 "Opus week": "opus wk", "Sonnet week": "sonnet wk"}
+
+#: Tie-break order for the windows that do not carry the bar.
+WINDOW_ORDER = ("5h", "wk", "opus wk", "sonnet wk")
+
+#: Short labels of the 5-hour window (Anthropic's "Current session", Codex's "Session"): it carries
+#: the bar until a longer window reaches ``WEEKLY_TAKEOVER_PCT``.
+SHORT_WINDOWS = ("5h", "session")
+WEEKLY_TAKEOVER_PCT = 90
+
+
+def _short_window_label(label) -> str:
+    text = str(label or "").strip()
+    words = text.split()
+    return WINDOW_LABELS.get(text, words[0].lower() if words else "usage")
+
+
+def format_window_duration(seconds) -> str:
+    """``4d`` / ``1d9h`` / ``2h14m`` / ``25m`` — zero components are dropped."""
+    total_minutes = max(0, int(seconds // 60))
+    days, rest = divmod(total_minutes, 1440)
+    hours, minutes = divmod(rest, 60)
+    if days:
+        return f"{days}d{hours}h" if hours else f"{days}d"
+    if hours:
+        return f"{hours}h{minutes}m" if minutes else f"{hours}h"
+    return f"{minutes}m"
+
+
+def format_window_percent(used_percent) -> str:
+    """One decimal below 10% (``1.5603 -> "1.6"``), integer at or above (``41.2 -> "41"``).
+
+    The *branch* comes from the value rounded to one decimal (so 9.96 and a
+    ``1 - 0.9 = 0.0999…`` float artifact both stay "10" rather than "10.0"), but the integer is
+    rounded from the raw number — rounding twice would print 12.46% as "13". ``round_half_up``
+    rather than the built-in ``round``, whose banker's rounding disagrees with the JS scripts.
+    """
+    value = float(used_percent)
+    one_decimal = round_half_up(value * 10) / 10
+    return f"{one_decimal:.1f}" if one_decimal < 10 else f"{round_half_up(value)}"
+
+
+def _seconds_until(reset_at, now) -> Optional[float]:
+    """Seconds until ``reset_at``, or ``None`` when it is unknown or not in the future."""
+    if reset_at is None:
+        return None
+    try:
+        delta = reset_at.timestamp() - float(now)
+    except (AttributeError, TypeError, ValueError, OSError, OverflowError):
+        return None
+    return delta if delta > 0 else None
+
+
+def _clamp_percent(percent) -> Optional[float]:
+    if percent is None or isinstance(percent, bool):
+        return None
+    try:
+        value = float(percent)
+    except (TypeError, ValueError):
+        return None
+    if value != value:  # NaN
+        return None
+    return max(0.0, min(100.0, value))
+
+
+def round_half_up(value) -> int:
+    """Nearest integer, halves rounding up — the rule ``render_bar`` fills with. Deliberately
+    not the built-in ``round``, whose banker's rounding makes 5% fill 0 cells."""
+    return math.floor(float(value) + 0.5)
+
+
+def render_bar(percent, width: int = BAR_WIDTH) -> str:
+    """Ten-cell ``█``/``░`` bar with no brackets — Claude Code's look.
+
+    ``None`` (no data yet) renders all-empty rather than a misleading empty/full bar. Fill
+    rounds half-up to the nearest cell (see ``round_half_up``; Python's built-in
+    ``round`` is banker's rounding, so ``5%`` would otherwise show 0 cells) and clamps to
+    ``0..width``.
+    """
+    safe = _clamp_percent(percent)
+    filled = 0 if safe is None else round_half_up(safe / 100.0 * width)
+    filled = max(0, min(width, filled))
+    return FILLED * filled + EMPTY * (width - filled)
+
+
+def usage_windows_label(windows, now, width: int = BAR_WIDTH, binding_only: bool = False):
+    """``(bar_percent, text)`` for the claude-style ``usage:`` segment, or ``(None, None)``.
+
+    ``windows`` are ``agent.account_usage.AccountUsageWindow``-shaped. The segment shows every live
+    window the provider published, labelled, at real precision — neither Anthropic nor Google
+    publishes a token or dollar magnitude for a subscription window, so the fraction *is* the real
+    value. The bar window comes first, with the bar between its label and its number
+    (``5h ░░░░░░░░░░ 1.0% (4h7m) · wk 3.0% (1d9h)``): the 5-hour window, unless a longer
+    account-scoped window has reached ``WEEKLY_TAKEOVER_PCT`` (or there is no live 5-hour window),
+    and then the account-scoped window with the highest ``used_percent``. A weekly budget is far
+    larger than a 5-hour one, so a higher weekly percentage does not mean it runs out first until it
+    is nearly spent. Model-scoped windows (``Opus week``) are shown but never take the bar, because
+    they cannot exhaust the account. A window whose ``reset_at`` has passed is dropped rather than
+    rendered stale; with no live window left the caller shows a real absolute value instead.
+
+    Every window keeps its label even when it is the only one (a provider that publishes a single
+    window, or whose others expired), so the survivor can never be mistaken for a different window.
+    ``binding_only`` renders just the bar window: the narrow-terminal form the caller falls back to
+    before giving up the segment entirely.
+    """
+    live = []
+    for window in windows or ():
+        used = getattr(window, "used_percent", None)
+        if used is None or isinstance(used, bool):
+            continue
+        try:
+            used = float(used)
+        except (TypeError, ValueError):
+            continue
+        if used != used:  # NaN
+            continue
+        reset_at = getattr(window, "reset_at", None)
+        if reset_at is not None and _seconds_until(reset_at, now) is None:
+            continue  # its window already reset
+        live.append((window, max(0.0, min(100.0, used))))
+    if not live:
+        return None, None
+    account = [(w, used) for w, used in live if getattr(w, "scope", "account") != "model"] or live
+    short = next((pair for pair in account
+                  if _short_window_label(getattr(pair[0], "label", "")) in SHORT_WINDOWS), None)
+    if short is not None and all(used < WEEKLY_TAKEOVER_PCT
+                                 for w, used in account if w is not short[0]):
+        bar_window, bar_pct = short
+    else:
+        bar_window, bar_pct = max(account, key=lambda pair: pair[1])
+    order = {name: index for index, name in enumerate(WINDOW_ORDER)}
+    rest = sorted(((w, used) for w, used in live if w is not bar_window),
+                  key=lambda pair: order.get(_short_window_label(getattr(pair[0], "label", "")), 99))
+    shown = [(bar_window, bar_pct)] if binding_only else [(bar_window, bar_pct)] + rest
+    parts = []
+    for index, (window, used) in enumerate(shown):
+        label = _short_window_label(getattr(window, "label", ""))
+        bar = f"{render_bar(bar_pct, width)} " if index == 0 else ""
+        seconds = _seconds_until(getattr(window, "reset_at", None), now)
+        parts.append(f"{label} {bar}{format_window_percent(used)}%"
+                     + (f" ({format_window_duration(seconds)})" if seconds is not None else ""))
+    return bar_pct, " · ".join(parts)
+
+
+def cwd_label(path) -> str:
+    """Basename of the session working directory, middle-truncated to ``MAX_DIR_CHARS``."""
+    raw = os.path.basename(os.path.normpath(str(path or "")))
+    if raw in ("", "."):
+        return ""
+    if len(raw) <= MAX_DIR_CHARS:
+        return raw
+    head = MAX_DIR_CHARS // 2
+    tail = MAX_DIR_CHARS - head - 1
+    return f"{raw[:head]}{ELLIPSIS}{raw[-tail:]}"
+
+
+def effort_label(reasoning_config, default: str = DEFAULT_EFFORT) -> str:
+    """Short effort word for the bar: the requested level, ``off`` when thinking is disabled.
+
+    Deliberately the *requested* level (``requested_effort``), not
+    ``effort_display_label``'s ``"ultra (sends max on this route)"`` — that route-clamp detail
+    belongs in ``/reasoning`` status, not a one-line bar.
+    """
+    from agent.reasoning_effort import requested_effort
+
+    if isinstance(reasoning_config, dict) and reasoning_config.get("enabled") is False:
+        return "off"
+    return requested_effort(reasoning_config) or default
