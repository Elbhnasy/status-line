@@ -0,0 +1,165 @@
+"""Unit tests for the pure Claude-style status-bar helpers (no live HermesCLI)."""
+
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from agent.account_usage import AccountUsageWindow
+from hermes_cli import status_bar_claude as sb
+
+
+@pytest.mark.parametrize("pct,expected", [
+    (None, "\u2591" * 10),          # no data yet -> all empty, never a fake full/zero bar
+    (0, "\u2591" * 10),
+    (5, "\u2588" + "\u2591" * 9),   # 0.5 rounds half-up -> 1 cell
+    (8, "\u2588" + "\u2591" * 9),   # round(0.8) = 1
+    (50, "\u2588" * 5 + "\u2591" * 5),
+    (79, "\u2588" * 8 + "\u2591" * 2),
+    (100, "\u2588" * 10),
+    (-5, "\u2591" * 10),
+    (150, "\u2588" * 10),
+])
+def test_render_bar(pct, expected):
+    assert sb.render_bar(pct) == expected
+
+
+def test_render_bar_width_override():
+    assert sb.render_bar(50, width=4) == "\u2588\u2588\u2591\u2591"
+
+
+# --- real usage windows -------------------------------------------------------------------------
+# The usage segment reports what the provider published: every window, labelled, at real precision,
+# with its reset countdown. The bar stays on the 5-hour window until a longer account-scoped
+# window reaches 90%; then the most-used account-scoped window takes it.
+
+NOW = datetime(2026, 10, 7, 7, 0, tzinfo=timezone.utc)
+EPOCH = NOW.timestamp()
+
+
+def _w(label, pct, hours, scope="account"):
+    return AccountUsageWindow(label=label, used_percent=pct,
+                              reset_at=NOW + timedelta(hours=hours), scope=scope)
+
+
+def test_usage_windows_label_puts_the_bar_on_5h_while_the_week_is_below_the_takeover():
+    windows = [_w("Current session", 1.0, 4 + 7 / 60), _w("Current week", 89.0, 33)]
+    assert sb.usage_windows_label(windows, EPOCH) == (
+        1.0, "5h " + "\u2591" * 10 + " 1.0% (4h7m) \u00b7 wk 89% (1d9h)")
+
+
+def test_usage_windows_label_week_at_the_takeover_takes_the_bar():
+    windows = [_w("Current session", 20.0, 2 + 14 / 60), _w("Current week", 90.0, 48)]
+    assert sb.usage_windows_label(windows, EPOCH) == (
+        90.0, "wk " + "\u2588" * 9 + "\u2591" + " 90% (2d) \u00b7 5h 20% (2h14m)")
+
+
+def test_usage_windows_label_past_the_takeover_the_more_used_window_keeps_the_bar():
+    windows = [_w("Current session", 95.0, 2 + 14 / 60), _w("Current week", 92.0, 48)]
+    assert sb.usage_windows_label(windows, EPOCH) == (
+        95.0, "5h " + "\u2588" * 10 + " 95% (2h14m) \u00b7 wk 92% (2d)")
+
+
+def test_usage_windows_label_keeps_one_decimal_below_ten():
+    windows = [_w("Current session", 1.5603, 4 + 33 / 60), _w("Current week", 0.2601, 6 * 24 + 23)]
+    assert sb.usage_windows_label(windows, EPOCH)[1] == \
+        "5h " + "\u2591" * 10 + " 1.6% (4h33m) \u00b7 wk 0.3% (6d23h)"
+
+
+def test_usage_windows_label_bar_ignores_model_scoped_windows():
+    windows = [_w("Current session", 1.0, 4.0), _w("Current week", 3.0, 33.0),
+               _w("Opus week", 96.8, 96.0, scope="model")]
+    assert sb.usage_windows_label(windows, EPOCH) == (
+        1.0, "5h " + "\u2591" * 10 + " 1.0% (4h) \u00b7 wk 3.0% (1d9h) \u00b7 opus wk 97% (4d)")
+
+
+def test_usage_windows_label_drops_windows_past_their_reset():
+    windows = [_w("Current session", 88.0, -1 / 60), _w("Current week", 41.2, 96.0)]
+    assert sb.usage_windows_label(windows, EPOCH) == (
+        41.2, "wk " + "\u2588\u2588\u2588\u2588" + "\u2591" * 6 + " 41% (4d)")
+
+
+def test_usage_windows_label_single_window_keeps_its_label():
+    # The provider may publish only one window (or the others expired): the label stays, so the
+    # survivor can never be read as a different window.
+    assert sb.usage_windows_label([_w("Current session", 42.0, 2 + 14 / 60)], EPOCH) == (
+        42.0, "5h " + "\u2588\u2588\u2588\u2588" + "\u2591" * 6 + " 42% (2h14m)")
+
+
+def test_usage_windows_label_binding_only_keeps_the_bar_window_and_drops_the_rest():
+    windows = [_w("Current session", 1.0, 4 + 7 / 60), _w("Current week", 41.2, 96.0)]
+    assert sb.usage_windows_label(windows, EPOCH, binding_only=True) == (
+        1.0, "5h " + "\u2591" * 10 + " 1.0% (4h7m)")
+
+
+def test_usage_windows_label_derives_codex_labels():
+    windows = [_w("Session", 30.0, 25 / 60), _w("Weekly", 41.0, 5 * 24)]
+    assert sb.usage_windows_label(windows, EPOCH)[1] == \
+        "session " + "\u2588" * 3 + "\u2591" * 7 + " 30% (25m) \u00b7 weekly 41% (5d)"
+
+
+def test_usage_windows_label_without_windows_is_none():
+    assert sb.usage_windows_label([], EPOCH) == (None, None)
+
+
+def test_usage_windows_label_counts_a_missing_reset_as_live():
+    window = AccountUsageWindow(label="Current session", used_percent=7.0, reset_at=None)
+    assert sb.usage_windows_label([window], EPOCH) == (7.0, "5h \u2588" + "\u2591" * 9 + " 7.0%")
+
+
+def test_window_duration_rule():
+    assert sb.format_window_duration(0) == "0m"
+    assert sb.format_window_duration(3540) == "59m"
+    assert sb.format_window_duration(3600) == "1h"
+    assert sb.format_window_duration(8040) == "2h14m"
+    assert sb.format_window_duration(118800) == "1d9h"
+    assert sb.format_window_duration(345600) == "4d"
+
+
+def test_window_percent_rule():
+    assert sb.format_window_percent(1.5603) == "1.6"
+    assert sb.format_window_percent(9.4) == "9.4"               # one decimal below 10
+    assert sb.format_window_percent(9.99) == "10"               # rounds onto the boundary, then integer
+    assert sb.format_window_percent(9.999999999999998) == "10"  # float artifact, not "10.0"
+    assert sb.format_window_percent(10) == "10"
+    assert sb.format_window_percent(12.46) == "12"              # no double rounding: not 12.5 -> 13
+    assert sb.format_window_percent(12.5) == "13"               # halves round up, as the JS scripts do
+    assert sb.format_window_percent(6.25) == "6.3"              # not Python's banker's rounding (6.2)
+    assert sb.format_window_percent(41.2) == "41"
+    assert sb.format_window_percent(100) == "100"
+
+
+def test_cwd_label_is_basename_and_truncates():
+    assert sb.cwd_label("projects/example-workspace") == "example-workspace"
+    assert sb.cwd_label("/") == ""
+    assert sb.cwd_label("") == ""
+    long = sb.cwd_label("/x/" + "a" * 40)
+    assert len(long) == sb.MAX_DIR_CHARS and "\u2026" in long
+
+
+def test_effort_label():
+    assert sb.effort_label(None) == "medium"          # unset -> documented default
+    assert sb.effort_label({"enabled": True, "effort": "high"}) == "high"
+    assert sb.effort_label({"enabled": False, "effort": "high"}) == "off"
+    assert sb.effort_label({"enabled": True, "effort": ""}) == "medium"
+
+
+def test_layout_order_constants():
+    # Rendering order is Claude's; drop order is least-important-first.
+    assert sb.SEGMENT_ORDER == ("dir", "model", "effort", "context", "usage")
+    assert sb.DROP_ORDER == ("dir", "effort", "usage")
+
+
+def test_default_config_documents_the_style():
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+    status_bar = DEFAULT_CONFIG["display"]["status_bar"]
+    assert status_bar["style"] == "default"
+    # The usage bar reads the provider's real windows: there is no token budget denominator.
+    assert "usage_budget" not in status_bar
+
+
+def test_labels_exist_in_the_english_catalog():
+    from agent.i18n import t
